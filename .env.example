APP_PORT=8000
TZ=Asia/Shanghai
LOG_LEVEL=info

# MySQL 数据库连接地址（Docker Compose 部署时使用 host.docker.internal 访问宿主机 MySQL；
# 本地 uv 直接运行时请把 host 换成 127.0.0.1，并确保 movie_pilot_lite 数据库存在或可自动创建）。
DATABASE_URL=mysql+pymysql://root:请替换为密码@host.docker.internal:3306/movie_pilot_lite?charset=utf8mb4

# 可选：容器访问 M-Team 时使用的代理。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,qbittorrent

# 视频下载服务（video-grab）令牌，与 ymc-pub/.env 的 VIDEO_GRAB_TOKEN 相同；留空则视频下载页提示未配置
VIDEO_GRAB_TOKEN=
